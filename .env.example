# ─────────────────────────────────────────────────────────────────────────────
# Pick ONE mode.
# ─────────────────────────────────────────────────────────────────────────────

# MODE 1 — LiteLLM proxy (what we run in production).
#
# The server mints a per-session virtual key: minutes-long, budget-capped, and
# restricted to a single model. The long-lived key never leaves the server.
# This is the only mode you should deploy anywhere public.
#
VOICE_MODE=litellm
LITELLM_PROXY_URL=https://your-litellm-proxy.example.com
LITELLM_MASTER_KEY=sk-...
VOICE_REALTIME_MODEL=your-realtime-model-alias
VOICE_TRANSCRIPTION_MODEL=your-transcription-model-alias

# Guardrails on the minted credential. Both are optional and default to 30m / 1.
VOICE_KEY_DURATION=30m
VOICE_KEY_BUDGET=1

# ─────────────────────────────────────────────────────────────────────────────
# MODE 2 — direct key, LOCAL DEVELOPMENT ONLY.
#
# There is no minting step here: the key below is handed to the browser as-is,
# because a browser WebSocket cannot send an Authorization header. Anyone with
# devtools open can read it and spend it.
#
# The route refuses to run this mode when NODE_ENV=production. Do not remove
# that check — use MODE 1 instead.
#
# VOICE_MODE=direct
# VOICE_ALLOW_INSECURE_DIRECT_KEY=true
# VOICE_REALTIME_URL=wss://api.openai.com/v1/realtime
# VOICE_API_KEY=sk-...
# VOICE_REALTIME_MODEL=gpt-realtime
# VOICE_TRANSCRIPTION_MODEL=whisper-1

# ─────────────────────────────────────────────────────────────────────────────
# Optional, both modes.
# ─────────────────────────────────────────────────────────────────────────────

# Which voice the agent speaks with. Which one suits your users is a listening
# exercise, not a code decision, so it is configuration.
# VOICE_NAME=cedar

# Slack incoming webhook. Upstream failures nobody using the app can act on
# (budget exhausted, key rejected, proxy unreachable) get posted here.
# VOICE_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
